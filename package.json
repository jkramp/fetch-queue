{
  "name": "fetch-queue",
  "version": "1.0.2",
  "description": "Fetch request queues with concurrency limits, retries, and cancellation",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "test:types": "tsc --project tsconfig.json",
    "test:package": "node scripts/check-package.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test:types && npm test && npm run test:package && npm run example && npm run test:docs",
    "prepublishOnly": "npm run check",
    "example": "node examples/batch.js",
    "test:docs": "node scripts/check-docs.js"
  },
  "author": "Jeff Kramp",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkramp/fetch-queue.git"
  },
  "bugs": {
    "url": "https://github.com/jkramp/fetch-queue/issues"
  },
  "homepage": "https://github.com/jkramp/fetch-queue#readme",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index.js": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "logo.svg",
    "CHANGELOG.md",
    "docs/api.md",
    "docs/migration.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/review.md",
    "examples/batch.js"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "fetch",
    "queue",
    "concurrency",
    "retry",
    "abort",
    "typescript"
  ]
}
